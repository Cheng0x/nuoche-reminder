# 服务端口
PORT=3000

# ===== 方式一：飞书自定义机器人（把消息发到群）=====
# 群设置 → 群机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=
# 若机器人开启了「签名校验」，填签名密钥；未开启留空
FEISHU_WEBHOOK_SECRET=

# ===== 方式二：飞书企业自建应用（私聊 + 电话加急，推荐）=====
# 飞书开放平台 → 创建企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 车主在飞书的标识：open_id / user_id / 手机号
FEISHU_RECEIVE_ID=
# 接收方类型：open_id | user_id | chat_id
FEISHU_RECEIVE_ID_TYPE=open_id
# 加急方式：phone=电话加急 | sms=短信加急 | none=不加急
FEISHU_URGENT=phone
